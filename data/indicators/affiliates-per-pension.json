  "periodRef": "period",
  "calculation": {
    "method": "Average affiliates in the month divided by contributory pensions in payment on day 1 of the same month.",
    "formula": "ss-affiliates / pensions-count",
    "inputs": [
      "ss-affiliates",
      "pensions-count"
    ],
